# Hypernet — every environment variable, documented. Values live ONLY in the sops-encrypted .env.enc.
# Edit with:  cd ~/Documents/CODE/hypernet-feed && sops-edit
# Neon project: "hypernet" (id billowing-rice-20515821), org "Michal", region Frankfurt (aws-eu-central-1).

# --- Neon database ------------------------------------------------------------------------------
# console.neon.tech → hypernet → Connect → Branch: dev → Database: hypernet → "Connection pooling" ON → copy
DATABASE_URL=
# same dialog, "Connection pooling" OFF (direct connection, used for migrations)
DATABASE_URL_UNPOOLED=
# same two, but Branch: main (production). The push script sends these to Vercel production as DATABASE_URL*.
DATABASE_URL_MAIN=
DATABASE_URL_MAIN_UNPOOLED=

# --- Neon API (lets Claude manage branches, Neon Auth and image storage without you) ------------
# console.neon.tech → Account settings (avatar, bottom left) → API keys → Create new → "Personal" → copy
NEON_API_KEY=
NEON_PROJECT_ID=billowing-rice-20515821

# --- Neon storage (image uploads; a storage-only credential, safer than the account API key) ----
# console.neon.tech → hypernet → branch main → Connect → Storage tab → "Parameters only":
#   AWS_ACCESS_KEY_ID value (nak_live_…)        → here
NEON_STORAGE_ACCESS_KEY_ID=
#   Reveal credential → AWS_SECRET_ACCESS_KEY (nsk_live_…) → here   (renamed: Vercel reserves AWS_* names)
NEON_STORAGE_SECRET_ACCESS_KEY=

# --- Vercel (lets Claude push env vars and deploy without you) ----------------------------------
# vercel.com/account/settings/tokens → Create Token → scope: the team that owns "hypernet-feed" → expiry 90 days
VERCEL_TOKEN=

# --- Email for login codes (Resend) ------------------------------------------------------------
# resend.com → API Keys → Create → permission "Sending access" → copy
RESEND_API_KEY=
# the sender address. Must be on a domain verified in Resend (resend.com → Domains). Until a domain is verified,
# Resend only delivers to your own account email — fine for testing.
EMAIL_FROM=Hypernet <login@yourdomain.com>

# --- Sessions ----------------------------------------------------------------------------------
# any long random string. Generate in a terminal:  openssl rand -base64 32
AUTH_SECRET=
