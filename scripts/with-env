#!/usr/bin/env bash
# Run a command with the git-ignored .env.local loaded into its environment (nothing is printed):
#   scripts/with-env ./node_modules/.bin/next dev --port 3000
#   scripts/with-env curl … --variable %DATABASE_URL_UNPOOLED …
# Lines are read as plain KEY=value (never evaluated by the shell), like dotenv: comments and blank lines skipped,
# one pair of outer quotes removed.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
file="$root/.env.local"
[ -f "$file" ] || { echo "with-env: $file not found (copy .env.example and fill it in)" >&2; exit 1; }
while IFS= read -r line || [ -n "$line" ]; do
  line="${line#"${line%%[![:space:]]*}"}"
  case "$line" in ''|'#'*) continue ;; esac
  line="${line#export }"
  [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=(.*)$ ]] || continue
  key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
  val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
  if [[ ${#val} -ge 2 && ( ( "${val:0:1}" == '"' && "${val: -1}" == '"' ) || ( "${val:0:1}" == "'" && "${val: -1}" == "'" ) ) ]]; then
    val="${val:1:${#val}-2}"
  fi
  export "$key=$val"
done < "$file"
exec "$@"
